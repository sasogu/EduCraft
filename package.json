{
  "name": "noa-engine",
  "version": "0.25.1",
  "description": "Experimental voxel game engine",
  "main": "src/index.js",
  "scripts": {
    "dev": "npm test",
    "start": "cd docs/hello-world && webpack-dev-server",
    "test": "cd docs/test && webpack-dev-server",
    "build": "npm run build:hello && npm run build:test",
    "build:hello": "cd docs/hello-world && NODE_OPTIONS=--openssl-legacy-provider webpack --mode production",
    "build:test": "cd docs/test && NODE_OPTIONS=--openssl-legacy-provider webpack --mode production --config webpack.config.js",
    "build:dev": "cd docs/test && NODE_OPTIONS=--openssl-legacy-provider webpack --mode development --config webpack.config.js",
    "smoke:build": "npm run build && test -s docs/hello-world/bundle.js && test -s docs/test/bundle.js",
    "check": "npm run smoke:build && npm --prefix server test",
    "deploy": "./scripts/deploy-vps.sh"
  },
  "author": "Andy Hall",
  "keywords": [
    "voxel",
    "game",
    "engine"
  ],
  "license": "MIT",
  "dependencies": {
    "aabb-3d": "andyhall/aabb-3d",
    "box-intersect": "^1.0.1",
    "dexie": "^3.0.3",
    "ent-comp": "^0.7.0",
    "fast-voxel-raycast": "^0.1.1",
    "game-inputs": "^0.2.0",
    "game-shell": "andyhall/game-shell",
    "gl-vec3": "^1.1.3",
    "ndarray": "^1.0.16",
    "ndarray-hash": "^1.0.0",
    "noa-engine": "^0.33.0",
    "voxel-aabb-sweep": "^0.5.0",
    "voxel-physics-engine": "^0.9.0"
  },
  "repository": "https://github.com/andyhall/noa",
  "bugs": {
    "url": "https://github.com/andyhall/noa/issues"
  },
  "devDependencies": {
    "webpack": "^4.26.0",
    "webpack-cli": "^3.1.2",
    "webpack-dev-server": "^3.1.11"
  }
}
